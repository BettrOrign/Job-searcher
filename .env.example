# ── Elasticsearch ──────────────────────────────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_INDEX=jobs

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JSearch API (OpenWebNinja) ────────────────────────────────
JSEARCH_API_BASE=https://api.openwebninja.com/jsearch
RAPIDAPI_KEY=your_openwebninja_api_key_here

# ── FastAPI ────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=info

# ── React frontend ─────────────────────────────────────────────
VITE_API_PROXY_TARGET=http://job-aggregator-backend:8000
FRONTEND_PORT=3000
